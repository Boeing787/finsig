{
  "name": "@finsig/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test src/domain/*.test.ts",
    "db:migrate": "node --env-file=../../.env.local --import tsx src/cli.ts migrate",
    "paypal:import": "node --env-file=../../.env.local --import tsx src/cli.ts import",
    "finsig:records": "node --env-file=../../.env.local --import tsx src/cli.ts records",
    "finsig:summary": "node --env-file=../../.env.local --import tsx src/cli.ts summary",
    "finsig:confirm": "node --env-file=../../.env.local --import tsx src/cli.ts confirm",
    "finsig:work": "node --env-file=../../.env.local --import tsx src/cli.ts work"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@finsig/eslint-config": "workspace:*",
    "@finsig/typescript-config": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "tsx": "^4.23.15"
  }
}
