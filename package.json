{
  "name": "finsig",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:migrate": "docker compose run --rm flyway migrate",
    "db:validate": "docker compose run --rm flyway validate",
    "paypal:probe": "node --env-file=.env.local scripts/paypal-reporting-probe.mjs",
    "paypal:verify-reporting": "node --env-file=.env.local scripts/paypal-verify-reporting.mjs",
    "paypal:seed-order": "node --env-file=.env.local scripts/paypal-create-sandbox-order.mjs",
    "paypal:capture-order": "node --env-file=.env.local scripts/paypal-capture-sandbox-order.mjs",
    "paypal:refund-capture": "node --env-file=.env.local scripts/paypal-refund-sandbox-capture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.10",
    "typescript": "^5.9.2"
  }
}
